  "panels": [
    {
      "type": "bargauge",
      "title": "Reported FB Occupancy by MIG Slice (%)",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "(DCGM_FI_DEV_FB_USED{GPU_I_ID!=\"\"} / (DCGM_FI_DEV_FB_USED{GPU_I_ID!=\"\"} + DCGM_FI_DEV_FB_FREE{GPU_I_ID!=\"\"})) * 100",
          "legendFormat": "GPU {{gpu}} / {{GPU_I_PROFILE}} / GI {{GPU_I_ID}}",
          "refId": "A",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 85
              },
              {
                "color": "red",
                "value": 95
              }
            ]
          },
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "showUnfilled": true
      },
      "id": 1,
      "description": "DCGM used / (used + free) framebuffer memory. Uses observed capacity instead of hardcoded nominal profile sizes. N/A means a required metric is unavailable."
    },
    {
      "type": "bargauge",
      "title": "Used Memory by MIG Slice (MiB)",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_FB_USED{GPU_I_ID!=\"\"}",
          "legendFormat": "GPU {{gpu}} / {{GPU_I_PROFILE}} / GI {{GPU_I_ID}}",
          "refId": "A",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "mbytes",
          "noValue": "N/A",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "showUnfilled": true
      },
      "id": 2,
      "description": "Reported framebuffer use in MiB. Compare pressure using the occupancy panel; a shared absolute threshold would misclassify larger MIG profiles."
    },
    {
      "type": "bargauge",
      "title": "MIG Compute Engine Activity (%)",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "DCGM_FI_PROF_GR_ENGINE_ACTIVE{GPU_I_ID!=\"\"}",
          "legendFormat": "GPU {{gpu}} / {{GPU_I_PROFILE}} / GI {{GPU_I_ID}}",
          "refId": "A",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0.0
              },
              {
                "color": "orange",
                "value": 0.6
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          },
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "showUnfilled": true
      },
      "id": 3,
      "description": "DCGM profiling activity ratio (0-1), displayed as a percentage. A100 MIG utilization is not available through the legacy NVML GPU utilization field. Availability depends on the driver, permissions and DCGM collector."
    },
    {
      "type": "state-timeline",
      "title": "Reported FB Occupancy State by MIG Slice",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "((DCGM_FI_DEV_FB_USED{GPU_I_ID!=\"\"} / (DCGM_FI_DEV_FB_USED{GPU_I_ID!=\"\"} + DCGM_FI_DEV_FB_FREE{GPU_I_ID!=\"\"})) >= bool 0.85) + ((DCGM_FI_DEV_FB_USED{GPU_I_ID!=\"\"} / (DCGM_FI_DEV_FB_USED{GPU_I_ID!=\"\"} + DCGM_FI_DEV_FB_FREE{GPU_I_ID!=\"\"})) >= bool 0.95)",
          "legendFormat": "GPU {{gpu}} / {{GPU_I_PROFILE}} / GI {{GPU_I_ID}}",
          "refId": "A",
          "interval": "15s"
        }
      ],
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "rowHeight": 0.85
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Below 85%",
                  "color": "green"
                },
                "1": {
                  "text": "At least 85%",
                  "color": "orange"
                },
                "2": {
                  "text": "At least 95%",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "noValue": "N/A"
        },
        "overrides": []
      },
      "id": 4,
      "description": "Used / (used + free) framebuffer memory reported by DCGM. States: 0 below 85%, 1 at least 85%, 2 at least 95%. High occupancy is a warning threshold, not proof that an allocation will fail. Missing samples remain N/A."
    },
