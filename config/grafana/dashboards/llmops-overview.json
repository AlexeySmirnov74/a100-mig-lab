      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(llm_guard_request_duration_seconds_bucket[5m])) by (le))",
          "refId": "A",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
