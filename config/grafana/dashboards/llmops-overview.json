  "panels": [
    {
      "type": "stat",
      "title": "RPS",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(llm_guard_requests_total[$__rate_interval]))",
          "refId": "A",
          "interval": "15s"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A"
        }
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "p95 Latency",
      "gridPos": {
        "h": 4,
        "w": 4,
