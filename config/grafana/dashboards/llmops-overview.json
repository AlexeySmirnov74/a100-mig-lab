    },
    {
      "type": "timeseries",
      "title": "Requests by Model (RPS)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(llm_guard_requests_total[$__rate_interval])) by (model)",
          "legendFormat": "{{model}}",
          "refId": "A",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A"
        }
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "p95 Latency by Model",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(llm_guard_request_duration_seconds_bucket[5m])) by (le, model))",
          "legendFormat": "{{model}}",
          "refId": "A",
          "interval": "15s"
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "In-flight by Model",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum(llm_guard_inflight_requests) by (model)",
          "legendFormat": "{{model}}",
          "refId": "A",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A"
        }
      },
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "GPU Memory Used by MIG Slice",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "mbytes",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_FB_USED{GPU_I_ID!=\"\"}",
          "legendFormat": "GPU {{gpu}} / {{GPU_I_PROFILE}} / GI {{GPU_I_ID}}",
          "refId": "A",
          "interval": "15s"
        }
      ],
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "MIG Compute Engine Activity (%)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "N/A",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "DCGM_FI_PROF_GR_ENGINE_ACTIVE{GPU_I_ID!=\"\"}",
          "legendFormat": "GPU {{gpu}} / {{GPU_I_PROFILE}} / GI {{GPU_I_ID}}",
          "refId": "A",
          "interval": "15s"
        }
      ],
      "id": 11,
      "description": "DCGM profiling activity ratio (0-1), displayed as a percentage. A100 MIG utilization is not available through the legacy NVML GPU utilization field. Availability depends on the driver, permissions and DCGM collector."
    },
    {
      "type": "state-timeline",
      "title": "Reported FB Occupancy State by MIG Slice",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "((DCGM_FI_DEV_FB_USED{GPU_I_ID!=\"\"} / (DCGM_FI_DEV_FB_USED{GPU_I_ID!=\"\"} + DCGM_FI_DEV_FB_FREE{GPU_I_ID!=\"\"})) >= bool 0.85) + ((DCGM_FI_DEV_FB_USED{GPU_I_ID!=\"\"} / (DCGM_FI_DEV_FB_USED{GPU_I_ID!=\"\"} + DCGM_FI_DEV_FB_FREE{GPU_I_ID!=\"\"})) >= bool 0.95)",
          "legendFormat": "GPU {{gpu}} / {{GPU_I_PROFILE}} / GI {{GPU_I_ID}}",
          "refId": "A",
          "interval": "15s"
        }
      ],
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "rowHeight": 0.9
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Below 85%",
                  "color": "green"
                },
                "1": {
                  "text": "At least 85%",
                  "color": "orange"
                },
                "2": {
                  "text": "At least 95%",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "noValue": "N/A"
        },
        "overrides": []
      },
      "id": 12,
      "description": "Used / (used + free) framebuffer memory reported by DCGM. States: 0 below 85%, 1 at least 85%, 2 at least 95%. High occupancy is a warning threshold, not proof that an allocation will fail. Missing samples remain N/A."
    },
    {
      "type": "timeseries",
      "title": "Physical GPU Temperature / Power",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "max by (instance, gpu) (DCGM_FI_DEV_GPU_TEMP)",
          "legendFormat": "Temperature GPU {{gpu}} ({{instance}})",
          "refId": "A",
          "interval": "15s"
        },
        {
          "expr": "max by (instance, gpu) (DCGM_FI_DEV_POWER_USAGE)",
          "legendFormat": "Power GPU {{gpu}} ({{instance}})",
          "refId": "B",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "watt"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "id": 13,
      "description": "Physical GPU sensors, grouped by exporter and physical GPU index. Temperature and board power are not independent measurements of individual MIG instances."
    },
    {
      "type": "timeseries",
      "title": "Context Resets by Model",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(llm_guard_context_resets_total[5m])) by (model)",
          "legendFormat": "{{model}}",
          "refId": "A",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A"
        }
      },
      "id": 14
    }
  ],
