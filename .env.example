HF_TOKEN=

# ===== ports =====
# Access remotely through an SSH tunnel. Set 0.0.0.0 only behind your own firewall/TLS.
BIND_HOST=127.0.0.1
OPENWEBUI_PORT=3000
LITELLM_PORT=4000
CONTEXT_GUARD_PORT=4010
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# ===== auth =====
OPENAI_API_KEY=dummy-local-key
OPENWEBUI_SECRET_KEY=change-this-to-a-very-long-random-secret-key-32chars-min
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ===== MIG UUIDs (autogenerated by scripts/03_export_env.sh) =====
MIG_GENERAL_UUID=
MIG_FAST_UUID=
MIG_TINY_UUID=
MIG_STRESS_UUID=

# ===== host / Compose =====
GPU_ID=0
COMPOSE_PROJECT_NAME=mig-lab
# Token limits are per tier in compose/docker-compose.yml; update guard budgets too.
